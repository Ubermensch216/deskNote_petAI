  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskNote.Companion.Core\DeskNote.Companion.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

</Project>
