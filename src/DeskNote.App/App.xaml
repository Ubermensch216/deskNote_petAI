<Application
    x:Class="DeskNote.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Note menu styles live here rather than on the note, because a Flyout is hosted in
                the popup root and never inherits from the window that opened it. A note has two
                menus now — AI and note settings — and both are built from the same four shapes, so
                keeping the shapes in one dictionary is what stops them from drifting apart.

                Only the styles are shared. The brushes that flatten these buttons stay local to
                each flyout: overriding ButtonBackground app-wide would strip the chrome off the
                real dialogs too.
            -->
            <Style x:Key="NoteMenuRowStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Padding" Value="8,7" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!--
                A tile is an icon with its name underneath. The icon is what the eye lands on and
                what makes the menu scannable; the name is kept because no glyph tells a first-time
                reader that this one rewrites the note in a formal register.
            -->
            <Style x:Key="NoteMenuTileStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Padding" Value="0,7" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="NoteMenuTileIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="16" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="NoteMenuTileLabelStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>

            <Style x:Key="NoteMenuCaptionStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="Margin" Value="8,6,0,2" />
            </Style>

            <!-- The glyph that stands in for a section caption on the settings menu's chip rows. -->
            <Style x:Key="NoteMenuSectionIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Opacity" Value="0.6" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
