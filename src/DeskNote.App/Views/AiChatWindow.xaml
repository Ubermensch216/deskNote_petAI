<Window
    x:Class="DeskNote.App.Views.AiChatWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DeskNote.App.Views">

    <!--
        Answers only. Nothing typed here edits a note, so there is no Apply button to press by
        mistake, and the answer can be read while the notes it came from stay open behind it.
    -->
    <Grid Padding="20,16,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="ActionTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="ScopeLabel"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="QuestionBox"
                Grid.Column="0"
                AcceptsReturn="False"
                KeyDown="OnQuestionKeyDown" />

            <Button
                x:Name="AskButton"
                Grid.Column="1"
                Style="{ThemeResource AccentButtonStyle}"
                Click="OnAskClicked" />
        </Grid>

        <Border
            Grid.Row="2"
            CornerRadius="8"
            Padding="12"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <ScrollViewer x:Name="AnswerScroll">
                <StackPanel Spacing="8">
                    <ProgressRing x:Name="Progress" IsActive="False" Visibility="Collapsed" Width="24" Height="24" HorizontalAlignment="Left" />
                    <TextBlock x:Name="AnswerText" IsTextSelectionEnabled="True" TextWrapping="Wrap" />

                    <!--
                        The notes the answer was allowed to read, shown before it arrives rather
                        than after. A local model of this size gets things wrong, and the useful
                        thing is not a confidence score but the ability to go and check.
                    -->
                    <StackPanel x:Name="SourcesPanel" Spacing="4" Visibility="Collapsed">
                        <Border x:Name="SourcesRule" Height="1" Margin="0,4" Opacity="0.25"
                                Background="{ThemeResource TextFillColorPrimaryBrush}" />
                        <TextBlock
                            x:Name="SourcesCaption"
                            Style="{ThemeResource CaptionTextBlockStyle}"
                            Opacity="0.6" />
                        <ItemsControl x:Name="SourceList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="views:AnswerSource">
                                    <HyperlinkButton
                                        Padding="0,2"
                                        Content="{x:Bind Label}"
                                        Tag="{x:Bind NoteId}"
                                        Click="OnSourceClicked" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="Status"
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.6"
                TextWrapping="Wrap" />

            <Button x:Name="CloseButton" Grid.Column="1" Click="OnCloseClicked" />
        </Grid>
    </Grid>
</Window>
