<Window
    x:Class="DeskNote.App.Views.AiProposalWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        A list of things the model believes it found, every one of them opt-out. Nothing here is
        written to the note or turned into a reminder until Apply (report p11).
    -->
    <Grid Padding="20,16,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="ActionTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="Attribution"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel
            x:Name="RunningPanel"
            Grid.Row="1"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Spacing="12">
            <ProgressRing x:Name="Progress" IsActive="True" Width="36" Height="36" />
            <TextBlock x:Name="RunningLabel" HorizontalAlignment="Center" Opacity="0.8" />
        </StackPanel>

        <ScrollViewer x:Name="ProposalScroll" Grid.Row="1" Visibility="Collapsed">
            <StackPanel x:Name="ProposalList" Spacing="6" />
        </ScrollViewer>

        <InfoBar
            x:Name="Notice"
            Grid.Row="1"
            VerticalAlignment="Center"
            IsOpen="False"
            IsClosable="False"
            Severity="Informational" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="Elapsed"
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.6" />

            <Button x:Name="CancelButton" Grid.Column="1" Click="OnCancelClicked" />
            <Button
                x:Name="ApplyButton"
                Grid.Column="2"
                Style="{ThemeResource AccentButtonStyle}"
                IsEnabled="False"
                Click="OnApplyClicked" />
        </Grid>
    </Grid>
</Window>
