<Window
    x:Class="DeskNote.App.Views.RelatedNotesWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DeskNote.App.Views">

    <!--
        Read-only. Nothing here edits or merges anything; it answers "what else did I write about
        this" and hands the user the note, which is the part they can act on.
    -->
    <Grid Padding="20,16,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="RelatedTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="RelatedHint"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>

        <ProgressRing
            x:Name="Progress"
            Grid.Row="1"
            IsActive="True"
            Width="28"
            Height="28"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />

        <ListView
            x:Name="RelatedList"
            Grid.Row="1"
            Visibility="Collapsed"
            SelectionMode="None"
            IsItemClickEnabled="True"
            ItemClick="OnRelatedClicked">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="views:RelatedRow">
                    <Grid ColumnSpacing="10" Padding="0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="4" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- The note's own colour, so a row is recognisable as the paper on the desktop. -->
                        <Border
                            Grid.Column="0"
                            CornerRadius="2"
                            Background="{x:Bind Color}" />

                        <StackPanel Grid.Column="1" Spacing="1">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Text="{x:Bind Preview}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Opacity="0.65"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!--
                            The strength of the match, and a louder word for the few that are so
                            close they are probably the same note written twice.
                        -->
                        <Border
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            CornerRadius="3"
                            Padding="6,1"
                            Background="{x:Bind BadgeBackground}">
                            <TextBlock
                                Text="{x:Bind Badge}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Foreground="{x:Bind BadgeForeground}" />
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <InfoBar
            x:Name="Notice"
            Grid.Row="1"
            VerticalAlignment="Center"
            IsOpen="False"
            IsClosable="False"
            Severity="Informational" />

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="Status"
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.6"
                TextWrapping="Wrap" />

            <!--
                The one thing this window can do besides open a note. It appears only when enough
                neighbours are close enough to be worth filing together.
            -->
            <Button
                x:Name="GroupButton"
                Grid.Column="1"
                Style="{ThemeResource AccentButtonStyle}"
                Visibility="Collapsed"
                Click="OnGroupClicked" />

            <Button x:Name="CloseButton" Grid.Column="2" Click="OnCloseClicked" />
        </Grid>
    </Grid>
</Window>
