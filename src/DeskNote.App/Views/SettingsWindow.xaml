<Window
    x:Class="DeskNote.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Settings is where the pet is chosen and named, so it is a character screen, not a form. It
        speaks the dashboard's language — the same hero band, indigo for the pet itself, teal for
        what it does, purple for when it stays quiet — because a user arrives here from the pet
        window's corner, and a page in system greys reads as a different application.

        Three things that used to be stated are now shown: the pet is a wall of portraits instead
        of a dropdown, its size is three sizes instead of three words, and quiet hours are a band
        across a day instead of two clocks. Colour comes from CompanionPalette in code, as it does
        on the dashboard, because most of it depends on runtime state — which pet is chosen, which
        one is still locked, whether a switch is on.
    -->
    <Grid x:Name="Board">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="16,16,16,18">
            <StackPanel Spacing="12">

                <!--
                    Hero. The pet you are about to change, at the size you are about to give it,
                    under the name you are about to type. Every control below writes to this band,
                    so a choice can be judged before it is saved.
                -->
                <Border x:Name="HeroCard" CornerRadius="18" Padding="16,14,16,15">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border x:Name="AvatarWell" Width="88" Height="88" CornerRadius="26">
                            <Grid
                                Width="54"
                                Height="72"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RenderTransformOrigin="0.5,1">
                                <Grid.RenderTransform>
                                    <ScaleTransform x:Name="AvatarSizeTransform" />
                                </Grid.RenderTransform>
                                <!-- The strip holds four frames; the viewport exposes exactly one. -->
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,54,72" />
                                </Grid.Clip>
                                <Canvas Width="54" Height="72">
                                    <Image
                                        x:Name="AvatarSpriteStrip"
                                        Width="216"
                                        Height="72"
                                        Canvas.Left="0"
                                        Canvas.Top="0"
                                        Stretch="Fill" />
                                </Canvas>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="6">
                            <TextBlock x:Name="PageTitle" FontSize="12" FontWeight="SemiBold" />
                            <TextBlock
                                x:Name="HeroName"
                                FontSize="22"
                                FontWeight="SemiBold"
                                TextTrimming="CharacterEllipsis" />

                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Border x:Name="SpeciesPill" CornerRadius="9" Padding="8,2,8,3">
                                    <TextBlock x:Name="SpeciesPillText" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                                <Border x:Name="StatusPill" CornerRadius="9" Padding="8,2,8,3">
                                    <TextBlock x:Name="StatusPillText" FontSize="12" FontWeight="SemiBold" />
                                </Border>
                            </StackPanel>

                            <TextBlock x:Name="LocalOnlyLabel" FontSize="11.5" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Who the pet is: its name, its species, its size. -->
                <Border x:Name="CharacterCard" CornerRadius="16" BorderThickness="1" Padding="16,14,16,16">
                    <StackPanel Spacing="13">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="CharacterAccent" Width="5" Height="18" CornerRadius="3" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="CharacterHeader"
                                Grid.Column="1"
                                FontSize="15"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                        </Grid>

                        <TextBox x:Name="PetNameInput" MaxLength="20" CornerRadius="10" />

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="PetPickerLabel" FontSize="12" FontWeight="SemiBold" />
                            <!-- Seven portraits. A dropdown made you open it to see what you had. -->
                            <Grid x:Name="PetTileHost" ColumnSpacing="8" RowSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>

                        <Border x:Name="DragonLockBox" CornerRadius="12" Padding="12,10">
                            <Grid ColumnSpacing="9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    FontFamily="Segoe UI Emoji"
                                    FontSize="14"
                                    Text="&#x1F512;"
                                    VerticalAlignment="Top" />
                                <TextBlock
                                    x:Name="DragonLockHint"
                                    Grid.Column="1"
                                    FontSize="12"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <StackPanel Spacing="8">
                            <TextBlock x:Name="PetSizeLabel" FontSize="12" FontWeight="SemiBold" />
                            <Grid x:Name="PetSizeHost" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- What the pet is allowed to do. -->
                <Border x:Name="BehaviorCard" CornerRadius="16" BorderThickness="1" Padding="16,14,16,16">
                    <StackPanel Spacing="11">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="BehaviorAccent" Width="5" Height="18" CornerRadius="3" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="CompanionHeader"
                                Grid.Column="1"
                                FontSize="15"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                        </Grid>

                        <TextBlock x:Name="CompanionDescription" FontSize="12.5" TextWrapping="Wrap" />
                        <StackPanel x:Name="BehaviorRows" Spacing="0" />
                    </StackPanel>
                </Border>

                <!-- When it says nothing at all. -->
                <Border x:Name="QuietCard" CornerRadius="16" BorderThickness="1" Padding="16,14,16,16">
                    <StackPanel Spacing="12">
                        <Grid ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="QuietAccent" Width="5" Height="18" CornerRadius="3" VerticalAlignment="Center" />
                            <TextBlock
                                x:Name="QuietHoursLabel"
                                Grid.Column="1"
                                FontSize="15"
                                FontWeight="SemiBold"
                                VerticalAlignment="Center" />
                        </Grid>

                        <StackPanel x:Name="QuietBody" Spacing="12">
                            <!--
                                A whole day, left to right, with the quiet part filled in. Two
                                clocks reading 20:00 and 09:00 never showed that the window crosses
                                midnight; a band that runs off both ends of the day does.
                            -->
                            <StackPanel Spacing="5">
                                <Border x:Name="QuietRail" Height="14" CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition x:Name="QuietSpanA" Width="0*" />
                                            <ColumnDefinition x:Name="QuietSpanB" Width="1*" />
                                            <ColumnDefinition x:Name="QuietSpanC" Width="0*" />
                                        </Grid.ColumnDefinitions>
                                        <Border x:Name="QuietFillA" CornerRadius="7" />
                                        <Border x:Name="QuietFillB" Grid.Column="1" CornerRadius="7" />
                                        <Border x:Name="QuietFillC" Grid.Column="2" CornerRadius="7" />
                                    </Grid>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="Tick0" FontSize="10.5" Text="00" />
                                    <TextBlock x:Name="Tick6" Grid.Column="1" FontSize="10.5" Text="06" />
                                    <TextBlock x:Name="Tick12" Grid.Column="2" FontSize="10.5" Text="12" />
                                    <TextBlock x:Name="Tick18" Grid.Column="3" FontSize="10.5" Text="18" />
                                    <TextBlock
                                        x:Name="Tick24"
                                        Grid.Column="3"
                                        FontSize="10.5"
                                        HorizontalAlignment="Right"
                                        Text="24" />
                                </Grid>
                            </StackPanel>

                            <TextBlock x:Name="QuietSummary" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />

                            <Grid ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TimePicker x:Name="QuietStart" ClockIdentifier="24HourClock" />
                                <TimePicker x:Name="QuietEnd" Grid.Column="1" ClockIdentifier="24HourClock" />
                            </Grid>
                        </StackPanel>

                        <TextBlock
                            x:Name="QuietInactiveHint"
                            FontSize="11.5"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!--
            Save is pinned. The page is long enough that the button used to be below the fold, and
            a settings screen whose changes are lost unless you scroll to the bottom is a trap.
        -->
        <Border x:Name="ActionBar" Grid.Row="1" Padding="16,12" BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="SaveStatus"
                    VerticalAlignment="Center"
                    FontSize="12.5"
                    TextWrapping="Wrap" />
                <Button
                    x:Name="CloseButton"
                    Grid.Column="1"
                    CornerRadius="10"
                    Padding="16,7"
                    Click="OnCloseClicked" />
                <Button
                    x:Name="SaveButton"
                    Grid.Column="2"
                    CornerRadius="10"
                    Padding="22,7"
                    Click="OnSaveClicked" />
            </Grid>
        </Border>
    </Grid>
</Window>
