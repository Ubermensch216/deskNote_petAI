<Window
    x:Class="DeskNote.App.Views.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <Grid Padding="28,24" RowSpacing="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="4">
                <TextBlock x:Name="PageTitle" Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="LocalOnlyLabel"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Opacity="0.7"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Grid.Row="1"
                Padding="20"
                CornerRadius="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <StackPanel Spacing="16">
                    <StackPanel Spacing="4">
                        <TextBlock x:Name="CompanionHeader" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock
                            x:Name="CompanionDescription"
                            Opacity="0.72"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <ToggleSwitch x:Name="CompanionEnabled" />
                    <ToggleSwitch x:Name="ProactiveEnabled" />
                    <ToggleSwitch x:Name="AlwaysVisible" />
                    <ToggleSwitch x:Name="ReduceMotion" />

                    <StackPanel Spacing="8">
                        <TextBlock x:Name="QuietHoursLabel" FontWeight="SemiBold" />
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TimePicker x:Name="QuietStart" Grid.Column="0" ClockIdentifier="24HourClock" />
                            <TimePicker x:Name="QuietEnd" Grid.Column="1" ClockIdentifier="24HourClock" />
                        </Grid>
                        <Grid ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="QuietStartLabel" Grid.Column="0" Opacity="0.65" />
                            <TextBlock x:Name="QuietEndLabel" Grid.Column="1" Opacity="0.65" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="SaveStatus"
                    VerticalAlignment="Center"
                    Opacity="0.7" />
                <Button
                    x:Name="SaveButton"
                    Grid.Column="1"
                    Style="{ThemeResource AccentButtonStyle}"
                    Click="OnSaveClicked" />
                <Button x:Name="CloseButton" Grid.Column="2" Click="OnCloseClicked" />
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
