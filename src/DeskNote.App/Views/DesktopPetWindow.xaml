<Window
    x:Class="DeskNote.App.Views.DesktopPetWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Background="Transparent">
        <!-- Bottom-aligned, with the margin under it set from the pet's drawn height in
             PositionSpeechBubble: the window is a fixed 250px tall but the animal inside it is
             not, so a top-anchored bubble drifted further from a small or young pet the smaller
             it was. It never takes the pointer — a click anywhere on the pet is the pet's. -->
        <Border
            x:Name="SpeechBubble"
            Width="210"
            Padding="12,9"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="#EE202124"
            BorderBrush="#5FFFFFFF"
            BorderThickness="1"
            CornerRadius="18"
            IsHitTestVisible="False"
            Visibility="Collapsed">
            <TextBlock
                x:Name="SpeechText"
                Foreground="White"
                FontSize="13"
                MaxLines="2"
                TextAlignment="Center"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap" />
        </Border>

        <!-- Care props are drawn as vector shapes rather than shipped as sprite sheets. Seven
             species times six care moments would be forty new strips to draw and ship; a bowl,
             some bubbles and a ball beside the existing rest pose read as the same moment at a
             fraction of the cost, and they stay sharp at every pet size. -->
        <Canvas
            x:Name="CareProp"
            Width="44"
            Height="44"
            Margin="0,0,18,26"
            HorizontalAlignment="Right"
            VerticalAlignment="Bottom"
            Opacity="0"
            IsHitTestVisible="False">
            <Canvas.RenderTransform>
                <TranslateTransform x:Name="CarePropLift" />
            </Canvas.RenderTransform>

            <Grid x:Name="FeedProp" Width="44" Height="44" Visibility="Collapsed">
                <Ellipse
                    Width="26"
                    Height="12"
                    Margin="9,12,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="#FFCE93" />
                <Path
                    Data="M 6,18 L 38,18 L 32,34 L 12,34 Z"
                    Fill="#E8EAED"
                    Stroke="#9AA0A6"
                    StrokeThickness="1.5" />
            </Grid>

            <Grid x:Name="CleanProp" Width="44" Height="44" Visibility="Collapsed">
                <Ellipse Width="14" Height="14" Margin="4,20,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#AED9FF" Opacity="0.85" />
                <Ellipse Width="18" Height="18" Margin="16,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#CDE7FF" Opacity="0.9" />
                <Ellipse Width="10" Height="10" Margin="28,24,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#AED9FF" Opacity="0.8" />
            </Grid>

            <Grid x:Name="SpecialProp" Width="44" Height="44" Visibility="Collapsed">
                <Path
                    Data="M 22,4 L 26,18 L 40,22 L 26,26 L 22,40 L 18,26 L 4,22 L 18,18 Z"
                    Fill="#FFE082"
                    Stroke="#F6C445"
                    StrokeThickness="1.5" />
            </Grid>

            <Grid x:Name="PlayProp" Width="44" Height="44" Visibility="Collapsed">
                <Ellipse
                    Width="26"
                    Height="26"
                    Margin="9,9,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Fill="#FF8A80"
                    Stroke="#E0554A"
                    StrokeThickness="1.5" />
                <Path
                    Data="M 9,22 L 35,22"
                    Stroke="#FFFFFF"
                    StrokeThickness="2"
                    Opacity="0.85" />
            </Grid>

            <Grid x:Name="GreetProp" Width="44" Height="44" Visibility="Collapsed">
                <Path
                    Data="M 22,36 C 6,24 8,10 22,16 C 36,10 38,24 22,36 Z"
                    Fill="#FF7BA0"
                    Stroke="#E0557F"
                    StrokeThickness="1.5" />
            </Grid>

            <Grid x:Name="RestProp" Width="44" Height="44" Visibility="Collapsed">
                <Path
                    Data="M 26,6 A 15,15 0 1 0 26,36 A 11,11 0 1 1 26,6 Z"
                    Fill="#FFF3B0"
                    Stroke="#E5D07A"
                    StrokeThickness="1.5" />
            </Grid>
        </Canvas>

        <Grid
            x:Name="SpriteViewport"
            Width="150"
            Height="200"
            Margin="0,0,0,0"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            Background="Transparent"
            RenderTransformOrigin="0.5,1"
            PointerPressed="OnPetPointerPressed"
            PointerMoved="OnPetPointerMoved"
            PointerReleased="OnPetPointerReleased"
            PointerCaptureLost="OnPetPointerCaptureLost">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="FacingTransform" ScaleX="-1" ScaleY="1" />
            </Grid.RenderTransform>
            <Grid.Clip>
                <RectangleGeometry x:Name="SpriteClip" Rect="0,0,150,200" />
            </Grid.Clip>
            <Canvas x:Name="SpriteCanvas" Width="150" Height="200">
                <Image
                    x:Name="SpriteStrip"
                    Width="600"
                    Height="200"
                    Canvas.Left="0"
                    Canvas.Top="0"
                    Source="ms-appx:///Assets/Companion/rabbit-walk.png"
                    Stretch="Fill" />
            </Canvas>
        </Grid>

        <!-- Drawn after the sprite so the ornament is never hidden behind the head it sits on,
             and never takes the pointer: every click inside the pet's box belongs to the pet.
             Both layers are lifted off the window floor by a translate rather than a margin,
             because what they have to follow is the pet's drawn height, not the window's. -->
        <Canvas
            x:Name="GrowthMark"
            Width="64"
            Height="40"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            RenderTransformOrigin="0.5,1"
            Visibility="Collapsed">
            <Canvas.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="GrowthMarkScale" />
                    <TranslateTransform x:Name="GrowthMarkLift" />
                </TransformGroup>
            </Canvas.RenderTransform>

            <!-- Stage two. Something that has just started growing. -->
            <Grid x:Name="SproutMark" Width="64" Height="40" Visibility="Collapsed">
                <Path
                    Data="M 32,40 C 30.8,31.3 30.8,24.8 32,17.8"
                    Stroke="#4E9A51"
                    StrokeThickness="3.4"
                    StrokeLineJoin="Round" />
                <Path
                    Data="M 32,27.5 C 20.8,28.8 13.3,21.3 13.3,12.5 C 24.5,11.3 30.8,18.8 32,27.5 Z"
                    Fill="#8FD694"
                    Stroke="#4E9A51"
                    StrokeThickness="1.4" />
                <Path
                    Data="M 32,20 C 43.3,21.3 50.8,13.8 50.8,5 C 39.5,3.8 33.3,11.3 32,20 Z"
                    Fill="#A8E3AC"
                    Stroke="#4E9A51"
                    StrokeThickness="1.4" />
            </Grid>

            <!-- Stage three. The two stars twinkle out of phase, so the pair reads as alive. -->
            <Grid x:Name="SparklesMark" Width="64" Height="40" Visibility="Collapsed">
                <Path
                    x:Name="SparkleLeft"
                    Data="M 16,11 L 18.6,17.4 L 25,20 L 18.6,22.6 L 16,29 L 13.4,22.6 L 7,20 L 13.4,17.4 Z"
                    Fill="#FFE082"
                    Stroke="#F2B705"
                    StrokeThickness="1.2" />
                <Path
                    x:Name="SparkleRight"
                    Data="M 48,7 L 50,12 L 55,14 L 50,16 L 48,21 L 46,16 L 41,14 L 46,12 Z"
                    Fill="#FFF0B8"
                    Stroke="#F2B705"
                    StrokeThickness="1.2" />
            </Grid>

            <!-- Stage four. One rung short of the crown, and drawn to look it. -->
            <Grid x:Name="HaloMark" Width="64" Height="40" Visibility="Collapsed">
                <Ellipse
                    Width="46"
                    Height="19"
                    Margin="9,11,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Stroke="#FFF6D6"
                    StrokeThickness="2"
                    Opacity="0.55" />
                <Ellipse
                    Width="36"
                    Height="12"
                    Margin="14,15,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Stroke="#FFE9A8"
                    StrokeThickness="4" />
            </Grid>

            <!-- Stage five. The only gold on the desktop, the way it is the only gold in the
                 dashboard. -->
            <Grid x:Name="CrownMark" Width="64" Height="40" Visibility="Collapsed">
                <Path
                    Data="M 14,34 L 16,13 L 25,23 L 32,9 L 39,23 L 48,13 L 50,34 Z"
                    Fill="#FFC94D"
                    Stroke="#D99A21"
                    StrokeThickness="1.5"
                    StrokeLineJoin="Round" />
                <Ellipse Width="5" Height="5" Margin="19,27,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#FFF3C4" />
                <Ellipse Width="5" Height="5" Margin="29.5,27,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#FFF3C4" />
                <Ellipse Width="5" Height="5" Margin="40,27,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#FFF3C4" />
            </Grid>
        </Canvas>

        <!-- What the pet is doing while it sits still. Each sleep glyph carries a dark outline
             under a pale fill: this floats over whatever wallpaper the user has, and a
             single-colour mark disappears against half of them. -->
        <Canvas
            x:Name="RestEffect"
            Width="70"
            Height="58"
            HorizontalAlignment="Center"
            VerticalAlignment="Bottom"
            IsHitTestVisible="False"
            RenderTransformOrigin="0.5,1"
            Visibility="Collapsed">
            <Canvas.RenderTransform>
                <ScaleTransform x:Name="RestEffectScale" />
            </Canvas.RenderTransform>

            <Grid x:Name="SleepMark" Width="70" Height="58" Visibility="Collapsed">
                <Grid x:Name="SleepZSmall" Width="70" Height="58">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SleepZSmallDrift" />
                    </Grid.RenderTransform>
                    <Path Data="M 6,44 L 14,44 L 6,52 L 14,52" Stroke="#2E3136" StrokeThickness="5" StrokeLineJoin="Round" />
                    <Path Data="M 6,44 L 14,44 L 6,52 L 14,52" Stroke="#F4F7FF" StrokeThickness="2.4" StrokeLineJoin="Round" />
                </Grid>
                <Grid x:Name="SleepZMedium" Width="70" Height="58">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SleepZMediumDrift" />
                    </Grid.RenderTransform>
                    <Path Data="M 22,26 L 32,26 L 22,36 L 32,36" Stroke="#2E3136" StrokeThickness="5.5" StrokeLineJoin="Round" />
                    <Path Data="M 22,26 L 32,26 L 22,36 L 32,36" Stroke="#F4F7FF" StrokeThickness="2.8" StrokeLineJoin="Round" />
                </Grid>
                <Grid x:Name="SleepZLarge" Width="70" Height="58">
                    <Grid.RenderTransform>
                        <TranslateTransform x:Name="SleepZLargeDrift" />
                    </Grid.RenderTransform>
                    <Path Data="M 42,4 L 55,4 L 42,17 L 55,17" Stroke="#2E3136" StrokeThickness="6" StrokeLineJoin="Round" />
                    <Path Data="M 42,4 L 55,4 L 42,17 L 55,17" Stroke="#F4F7FF" StrokeThickness="3.2" StrokeLineJoin="Round" />
                </Grid>
            </Grid>

            <Grid x:Name="DaydreamMark" Width="70" Height="58" Visibility="Collapsed">
                <Ellipse x:Name="DaydreamDotSmall" Width="6" Height="6" Margin="11,46,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#F1F3F4" Stroke="#4A4D51" StrokeThickness="1.4" />
                <Ellipse x:Name="DaydreamDotMedium" Width="9" Height="9" Margin="27,30,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#F1F3F4" Stroke="#4A4D51" StrokeThickness="1.5" />
                <Ellipse x:Name="DaydreamDotLarge" Width="12" Height="12" Margin="46,11,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#F1F3F4" Stroke="#4A4D51" StrokeThickness="1.6" />
            </Grid>
        </Canvas>
    </Grid>
</Window>
