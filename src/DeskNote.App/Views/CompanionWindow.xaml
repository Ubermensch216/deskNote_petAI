<Window
    x:Class="DeskNote.App.Views.CompanionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
      <Border
          Padding="18"
          CornerRadius="16"
          BorderThickness="1"
          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
        <Grid RowSpacing="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="72"
                    Height="72"
                    CornerRadius="36"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                    <!-- The strip is the same asset used by the desktop pet. The viewport
                         exposes exactly one of its four frames, so no neighbouring face leaks in. -->
                    <Grid
                        x:Name="AvatarViewport"
                        Width="54"
                        Height="72"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <Grid.Clip>
                            <RectangleGeometry Rect="0,0,54,72" />
                        </Grid.Clip>
                        <Canvas Width="54" Height="72">
                            <Image
                                x:Name="AvatarSpriteStrip"
                                Width="216"
                                Height="72"
                                Canvas.Left="0"
                                Canvas.Top="0"
                                Stretch="Fill"
                                Source="ms-appx:///Assets/Companion/rabbit-walk.png" />
                        </Canvas>
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock x:Name="CompanionName" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock
                        x:Name="MoodLabel"
                        Opacity="0.72"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="1" Spacing="8">
                <Border
                    Padding="12"
                    CornerRadius="10"
                    Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock x:Name="RecentReason" TextWrapping="Wrap" />
                </Border>

                <Border
                    x:Name="SuggestionCard"
                    Padding="12"
                    CornerRadius="10"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                    Visibility="Collapsed">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="SuggestionText" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
                            <Button x:Name="SuggestionDismiss" Click="OnSuggestionDismissed" />
                            <Button
                                x:Name="SuggestionOpen"
                                Style="{ThemeResource AccentButtonStyle}"
                                Click="OnSuggestionOpened" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Grid.Row="2" Spacing="9">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="CuriosityLabel" VerticalAlignment="Center" />
                    <ProgressBar x:Name="CuriosityBar" Grid.Column="1" Maximum="100" />
                    <TextBlock x:Name="CuriosityValue" Grid.Column="2" TextAlignment="Right" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="InsightLabel" VerticalAlignment="Center" />
                    <ProgressBar x:Name="InsightBar" Grid.Column="1" Maximum="100" />
                    <TextBlock x:Name="InsightValue" Grid.Column="2" TextAlignment="Right" />
                </Grid>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="76" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="ReliabilityLabel" VerticalAlignment="Center" />
                    <ProgressBar x:Name="ReliabilityBar" Grid.Column="1" Maximum="100" />
                    <TextBlock x:Name="ReliabilityValue" Grid.Column="2" TextAlignment="Right" />
                </Grid>
            </StackPanel>

            <StackPanel Grid.Row="3" Spacing="8">
                <TextBlock x:Name="RitualHeader" FontWeight="SemiBold" />
                <StackPanel x:Name="RitualChoices" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="CaptureRitual" Tag="Capture" Click="OnRitualClicked" />
                    <Button x:Name="RecallRitual" Tag="Recall" Click="OnRitualClicked" />
                    <Button x:Name="ResolveRitual" Tag="Resolve" Click="OnRitualClicked" />
                </StackPanel>
                <TextBlock
                    x:Name="RitualStatus"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <Grid Grid.Row="4" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="StageLabel"
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}"
                    Opacity="0.7" />
                <Button x:Name="SettingsButton" Grid.Column="1" Click="OnSettingsClicked" />
            </Grid>
        </Grid>
      </Border>
    </ScrollViewer>
</Window>
