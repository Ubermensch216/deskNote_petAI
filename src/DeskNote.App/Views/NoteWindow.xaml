<Window
    x:Class="DeskNote.App.Views.NoteWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DeskNote.App.Views">

    <!--
        The window itself is transparent; this Border is the visible note. Painting the paper here
        rather than on the window is what lets per-note opacity apply to the surface alone while
        the text above it stays fully opaque (report p4).
    -->
    <Border
        x:Name="Surface"
        CornerRadius="10"
        BorderThickness="1"
        AllowDrop="True"
        SizeChanged="OnSurfaceSizeChanged"
        DragOver="OnSurfaceDragOver"
        Drop="OnSurfaceDrop"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited">

        <Border.Resources>
            <!--
                Chrome buttons sit on paper, not on a form: no fill, no border, and a hit area big
                enough to click. Their brushes are overridden per note in ApplyPaperBrushes so the
                hover tint is made from the note's own ink rather than the system accent grey.
            -->
            <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="MinHeight" Value="0" />
                <Setter Property="Width" Value="28" />
                <Setter Property="Height" Value="24" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style x:Key="FormatButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="Width" Value="30" />
                <Setter Property="Height" Value="26" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!--
                Narrower than the format buttons on purpose. The bar already uses 219pt of the
                298pt a medium note has, and these two only appear while text is selected — they
                have to fit in what is left rather than push the image button off the edge.
            -->
            <Style x:Key="SelectionActionStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="Width" Value="26" />
                <Setter Property="Height" Value="26" />
                <Setter Property="FontSize" Value="14" />
            </Style>

            <!-- AI is what this app is for, so its entry point is a wider, named button. -->
            <Style x:Key="AiButtonStyle" TargetType="Button" BasedOn="{StaticResource ChromeButtonStyle}">
                <Setter Property="Width" Value="40" />
            </Style>
        </Border.Resources>

        <Grid Padding="12,3,10,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!--
                Drag handle and window commands in one strip. Pointer events are handled here rather
                than through Window.SetTitleBar: with the caption removed by the presenter there is
                no title bar for a XAML drag region to attach to, and the note could not be moved.
            -->
            <Grid
                x:Name="DragStrip"
                Grid.Row="0"
                Height="26"
                Background="Transparent"
                PointerPressed="OnDragStripPointerPressed"
                PointerMoved="OnDragStripPointerMoved"
                PointerReleased="OnDragStripPointerReleased"
                PointerCaptureLost="OnDragStripPointerReleased">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                    Hidden at rest so the note's content is the whole note, revealed on hover or
                    keyboard focus (report p4). Opacity rather than Visibility keeps the layout from
                    shifting as the buttons appear; IsHitTestVisible follows it so an invisible
                    button can never be clicked by accident.
                -->
                <StackPanel x:Name="LeadingChrome" Grid.Column="0" Orientation="Horizontal" Opacity="0">
                    <StackPanel.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.12" />
                    </StackPanel.OpacityTransition>

                    <Button x:Name="NewNoteButton" Style="{StaticResource ChromeButtonStyle}" Click="OnNewNoteClicked">
                        <FontIcon Glyph="&#xE710;" FontSize="12" />
                    </Button>
                </StackPanel>

                <!--
                    The note's title, which is its first line. There is no title field to fill in,
                    so this is where a user finds out what their note is called: it appears with
                    the rest of the chrome and is not hit-testable, leaving the strip a drag handle.
                -->
                <TextBlock
                    x:Name="TitleLabel"
                    Grid.Column="1"
                    Margin="8,0,8,0"
                    FontSize="11"
                    VerticalAlignment="Center"
                    TextAlignment="Center"
                    TextTrimming="CharacterEllipsis"
                    IsHitTestVisible="False"
                    Opacity="0">
                    <TextBlock.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.12" />
                    </TextBlock.OpacityTransition>
                </TextBlock>

                <StackPanel x:Name="TrailingChrome" Grid.Column="2" Orientation="Horizontal" Opacity="0">
                    <StackPanel.OpacityTransition>
                        <ScalarTransition Duration="0:0:0.12" />
                    </StackPanel.OpacityTransition>

                    <!--
                        AI has its own button rather than a section inside the ⋯ menu. It is the
                        product, not one more note setting, and burying it three scrolls down a
                        menu of colours said the opposite. The sparkle carries it and the word
                        "AI" is spelled out beside it: this is the one place in the note where a
                        glyph on its own would leave the app's whole point to be guessed at.
                    -->
                    <Button x:Name="AiButton" Style="{StaticResource AiButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <FontIcon x:Name="AiButtonIcon" Glyph="&#xE794;" FontSize="12" />
                            <TextBlock Text="AI" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout x:Name="AiFlyout" Placement="Bottom" Opened="OnAiFlyoutOpened" Closed="OnMenuFlyoutClosed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="10" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MaxWidth" Value="320" />
                                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />
                                        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Enabled" />
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <!--
                                    Capped and scrollable for the same reason as the settings menu:
                                    an unpackaged WinUI popup cannot leave its window, so on a
                                    240×180 note the rows past the bottom edge would be drawn where
                                    nobody can click them.
                                -->
                                <ScrollViewer
                                    x:Name="AiMenuScroll"
                                    VerticalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="AiMenuPanel" Width="248" Spacing="2">
                                        <StackPanel.Resources>
                                            <!--
                                                The flyout lives in the popup root, outside the
                                                note's visual tree, so the paper brushes applied to
                                                Surface do not reach it. These keys make the rows
                                                flat here, and the system supplies the hover fill.
                                            -->
                                            <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                            <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                        </StackPanel.Resources>

                                        <!--
                                            The same shape as the settings menu: the category sits
                                            in the 26pt gutter and everything to its right belongs
                                            to it. Read down the gutter and the three things AI
                                            does to a note are there before a single tile has been
                                            read. Captions above the rows said as much, but each
                                            spent a row of its own saying it, and a 180pt note
                                            cannot spare that three times over.
                                        -->
                                        <Grid ColumnSpacing="4" Margin="4,2,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon x:Name="AiTidySectionIcon" Grid.Column="0" Glyph="&#xE70F;" Style="{StaticResource NoteMenuSectionIconStyle}" />

                                            <Button x:Name="AiSummarize" Grid.Column="1" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnAiActionChipClicked">
                                                <StackPanel Spacing="4">
                                                    <FontIcon Glyph="&#xE71C;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                    <TextBlock x:Name="AiSummarizeLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AiOrganize" Grid.Column="2" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnAiActionChipClicked">
                                                <StackPanel Spacing="4">
                                                    <FontIcon Glyph="&#xE8A1;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                    <TextBlock x:Name="AiOrganizeLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                                </StackPanel>
                                            </Button>

                                            <!--
                                                A note is named by its first line, so a note that
                                                opens with a checklist item is filed under that
                                                item. This proposes a heading line instead of
                                                inventing a title field the note does not have.
                                            -->
                                            <Button x:Name="AiTitle" Grid.Column="3" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnAiTitleClicked">
                                                <StackPanel Spacing="4">
                                                    <FontIcon Glyph="&#xE8AC;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                    <TextBlock x:Name="AiTitleLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <Grid ColumnSpacing="4" Margin="4,2,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon x:Name="AiRewriteSectionIcon" Grid.Column="0" Glyph="&#xE8AB;" Style="{StaticResource NoteMenuSectionIconStyle}" />

                                            <Button x:Name="AiRewriteConcise" Grid.Column="1" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnAiRewriteChipClicked">
                                                <StackPanel Spacing="4">
                                                    <FontIcon Glyph="&#xE8C6;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                    <TextBlock x:Name="AiRewriteConciseLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AiRewriteFormal" Grid.Column="2" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnAiRewriteChipClicked">
                                                <StackPanel Spacing="4">
                                                    <FontIcon Glyph="&#xE8A5;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                    <TextBlock x:Name="AiRewriteFormalLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AiRewriteFriendly" Grid.Column="3" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnAiRewriteChipClicked">
                                                <StackPanel Spacing="4">
                                                    <FontIcon Glyph="&#xE76E;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                    <TextBlock x:Name="AiRewriteFriendlyLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AiRewriteReport" Grid.Column="4" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnAiRewriteChipClicked">
                                                <StackPanel Spacing="4">
                                                    <FontIcon Glyph="&#xE9F9;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                    <TextBlock x:Name="AiRewriteReportLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!--
                                            These two do not rewrite the note: they propose a list
                                            the user ticks through, which is why they answer to a
                                            category of their own rather than sitting among the
                                            rewrite tiles.
                                        -->
                                        <Grid ColumnSpacing="4" Margin="4,2,4,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>

                                            <FontIcon x:Name="AiExtractSectionIcon" Grid.Column="0" Glyph="&#xE896;" Style="{StaticResource NoteMenuSectionIconStyle}" />

                                            <Button x:Name="AiExtractTasks" Grid.Column="1" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnAiListChipClicked">
                                                <StackPanel Spacing="4">
                                                    <FontIcon Glyph="&#xE762;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                    <TextBlock x:Name="AiExtractTasksLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                                </StackPanel>
                                            </Button>
                                            <Button x:Name="AiSuggestTags" Grid.Column="2" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnAiListChipClicked">
                                                <StackPanel Spacing="4">
                                                    <FontIcon Glyph="&#xE8EC;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                    <TextBlock x:Name="AiSuggestTagsLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <Border x:Name="AiMenuSeparator" Height="1" Margin="4,6,4,4" />

                                        <!--
                                            Neither of these edits the note and both open a window
                                            of their own, which is what the full-width rows say.
                                            The related-notes row costs no generation at all — it
                                            is a cosine over vectors that are already stored.
                                        -->
                                        <Button x:Name="AiRelated" Style="{StaticResource NoteMenuRowStyle}" IsEnabled="False" Click="OnAiRelatedClicked">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE71B;" FontSize="14" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="AiRelatedLabel" Grid.Column="1" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <Button x:Name="AiAsk" Style="{StaticResource NoteMenuRowStyle}" IsEnabled="False" Click="OnAiAskChipClicked">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <FontIcon Grid.Column="0" Glyph="&#xE9CE;" FontSize="14" HorizontalAlignment="Left" />
                                                <TextBlock x:Name="AiAskLabel" Grid.Column="1" VerticalAlignment="Center" />
                                            </Grid>
                                        </Button>

                                        <!--
                                            Every tile above is disabled unless a local model
                                            answered a probe. The note app never depends on AI, so
                                            the menu is present but inert rather than hidden: a
                                            user who installed a model should find where it went,
                                            and one who did not should be told why nothing works.
                                        -->
                                        <TextBlock
                                            x:Name="AiStatus"
                                            Style="{StaticResource NoteMenuCaptionStyle}"
                                            Margin="8,6,8,2"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="MoreButton" Style="{StaticResource ChromeButtonStyle}">
                        <FontIcon Glyph="&#xE712;" FontSize="12" />

                        <Button.Flyout>
                            <!--
                                A custom Flyout rather than a MenuFlyout: the colours are the first
                                thing this menu is for, and a MenuFlyout cannot hold a swatch row.
                                What is left here is everything about the note as an object — how it
                                looks, how big it is, when it speaks up, where it is filed. The AI
                                commands moved to their own button.
                            -->
                            <Flyout x:Name="MoreFlyout" Placement="Bottom" Opened="OnMoreFlyoutOpened" Closed="OnMenuFlyoutClosed">
                                <Flyout.FlyoutPresenterStyle>
                                    <Style TargetType="FlyoutPresenter">
                                        <Setter Property="Padding" Value="6" />
                                        <Setter Property="CornerRadius" Value="10" />
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="MaxWidth" Value="320" />
                                        <Setter Property="ScrollViewer.HorizontalScrollMode" Value="Disabled" />

                                        <!--
                                            An unpackaged WinUI popup cannot leave its window, so a
                                            menu taller than the note is clipped rather than shown.
                                            Scrolling is what keeps every row reachable on a 240×180
                                            note; without it the sections at the bottom exist but
                                            cannot be clicked.
                                        -->
                                        <Setter Property="ScrollViewer.VerticalScrollMode" Value="Enabled" />
                                        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
                                    </Style>
                                </Flyout.FlyoutPresenterStyle>

                                <ScrollViewer
                                    x:Name="MenuScroll"
                                    VerticalScrollMode="Enabled"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollMode="Disabled"
                                    HorizontalScrollBarVisibility="Disabled">
                                <StackPanel x:Name="MenuPanel" Width="248" Spacing="2">
                                    <StackPanel.Resources>
                                        <!--
                                            The flyout lives in the popup root, outside the note's
                                            visual tree, so the paper brushes applied to Surface do
                                            not reach it. These keys make the rows flat here, and
                                            the system supplies the hover fill.
                                        -->
                                        <SolidColorBrush x:Key="ButtonBackground" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBackgroundDisabled" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrush" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="Transparent" />
                                        <SolidColorBrush x:Key="ButtonBorderBrushDisabled" Color="Transparent" />
                                    </StackPanel.Resources>

                                    <!--
                                        Plain buttons rather than a GridView: the list is eight fixed
                                        swatches with no selection state worth keeping, and GridViewItem
                                        chrome padded them wide enough to reflow into three columns.
                                        The colour lives on an inner Border because the Button template
                                        repaints its own background on hover, which would wash the
                                        swatch out exactly when the pointer is on it.
                                    -->
                                    <ItemsControl x:Name="ColorChoices">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <VariableSizedWrapGrid Orientation="Horizontal" ItemWidth="30" ItemHeight="34" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="views:NoteColorChoice">
                                                <Button
                                                    Width="30"
                                                    Height="34"
                                                    Padding="0"
                                                    MinWidth="0"
                                                    Background="Transparent"
                                                    CornerRadius="8"
                                                    Tag="{x:Bind Key}"
                                                    AutomationProperties.Name="{x:Bind Label}"
                                                    ToolTipService.ToolTip="{x:Bind Label}"
                                                    Click="OnColorChosen">
                                                    <Grid>
                                                        <Border
                                                            Width="24"
                                                            Height="24"
                                                            CornerRadius="7"
                                                            BorderThickness="1"
                                                            Background="{x:Bind Brush}"
                                                            BorderBrush="{x:Bind Outline}" />
                                                        <TextBlock
                                                            Text="&#x2713;"
                                                            FontSize="14"
                                                            HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Foreground="{x:Bind CheckBrush}"
                                                            Visibility="{x:Bind CheckVisibility}" />
                                                    </Grid>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!--
                                        Opacity floors at Note.MinOpacity rather than 0: report p4
                                        allows the surface to be translucent but never at the cost of
                                        text contrast, and a fully transparent note is unreadable.

                                        The half-filled disc replaces the slider's text header. On a
                                        menu this narrow a caption line costs more than it explains,
                                        and the glyph sits in the same 26px gutter as the two chip
                                        rows below, which lines the whole menu up on one edge.
                                    -->
                                    <Grid ColumnSpacing="4" Margin="4,2,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon x:Name="OpacityIcon" Grid.Column="0" Glyph="&#xE793;" Style="{StaticResource NoteMenuSectionIconStyle}" />
                                        <Slider
                                            x:Name="OpacitySlider"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            StepFrequency="5"
                                            ValueChanged="OnOpacityChanged" />
                                    </Grid>

                                    <Border x:Name="MenuSeparator1" Height="1" Margin="4,4" />

                                    <Grid ColumnSpacing="4" Margin="4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon x:Name="SizeSectionIcon" Grid.Column="0" Glyph="&#xE740;" Style="{StaticResource NoteMenuSectionIconStyle}" />

                                        <!--
                                            Three rectangles at the sizes they stand for. No glyph in
                                            the icon font means "medium note", and drawing the answer
                                            needs no legend in any language.
                                        -->
                                        <Button x:Name="SizeSmall" Grid.Column="1" Style="{StaticResource NoteMenuTileStyle}" Click="OnSizeChipClicked">
                                            <StackPanel Spacing="4">
                                                <Grid Height="16">
                                                    <Border x:Name="SizeSmallMark" Width="10" Height="8" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Grid>
                                                <TextBlock x:Name="SizeSmallLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SizeMedium" Grid.Column="2" Style="{StaticResource NoteMenuTileStyle}" Click="OnSizeChipClicked">
                                            <StackPanel Spacing="4">
                                                <Grid Height="16">
                                                    <Border x:Name="SizeMediumMark" Width="14" Height="11" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Grid>
                                                <TextBlock x:Name="SizeMediumLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="SizeLarge" Grid.Column="3" Style="{StaticResource NoteMenuTileStyle}" Click="OnSizeChipClicked">
                                            <StackPanel Spacing="4">
                                                <Grid Height="16">
                                                    <Border x:Name="SizeLargeMark" Width="18" Height="14" CornerRadius="2" VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                </Grid>
                                                <TextBlock x:Name="SizeLargeLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Grid ColumnSpacing="4" Margin="4,2,4,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="26" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <FontIcon x:Name="RemindSectionIcon" Grid.Column="0" Glyph="&#xEA8F;" Style="{StaticResource NoteMenuSectionIconStyle}" />

                                        <!--
                                            The offsets keep their words. A stopwatch and a clock say
                                            "soon" and "later"; no glyph says ten minutes rather than
                                            fifteen, so the number stays written out.
                                        -->
                                        <Button x:Name="Remind10Minutes" Grid.Column="1" Style="{StaticResource NoteMenuTileStyle}" Click="OnReminderChipClicked">
                                            <StackPanel Spacing="4">
                                                <FontIcon Glyph="&#xE916;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                <TextBlock x:Name="Remind10MinutesLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="Remind1Hour" Grid.Column="2" Style="{StaticResource NoteMenuTileStyle}" Click="OnReminderChipClicked">
                                            <StackPanel Spacing="4">
                                                <FontIcon Glyph="&#xE917;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                <TextBlock x:Name="Remind1HourLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                            </StackPanel>
                                        </Button>
                                        <Button x:Name="RemindTomorrow" Grid.Column="3" Style="{StaticResource NoteMenuTileStyle}" Click="OnReminderChipClicked">
                                            <StackPanel Spacing="4">
                                                <FontIcon Glyph="&#xE787;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                <TextBlock x:Name="RemindTomorrowLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                            </StackPanel>
                                        </Button>

                                        <!--
                                            The fourth chip is for everything the other three
                                            cannot say: a weekday, a date, or a repeat. It needs a
                                            model, so it greys out with the rest of the AI when
                                            there is none.
                                        -->
                                        <Button x:Name="RemindCustom" Grid.Column="4" Style="{StaticResource NoteMenuTileStyle}" IsEnabled="False" Click="OnRemindCustomClicked">
                                            <StackPanel Spacing="4">
                                                <FontIcon Glyph="&#xE70F;" Style="{StaticResource NoteMenuTileIconStyle}" />
                                                <TextBlock x:Name="RemindCustomLabel" Style="{StaticResource NoteMenuTileLabelStyle}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>

                                    <Border x:Name="MenuSeparator2" Height="1" Margin="4,6,4,4" />

                                    <Button x:Name="PinRow" Style="{StaticResource NoteMenuRowStyle}" Click="OnPinRowClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <!-- Outline pin when off, filled when on: the row states its answer twice. -->
                                            <FontIcon x:Name="PinRowIcon" Grid.Column="0" Glyph="&#xE718;" FontSize="14" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="PinRowLabel" Grid.Column="1" VerticalAlignment="Center" />
                                            <TextBlock x:Name="PinRowCheck" Grid.Column="2" Text="&#x2713;" FontSize="13" Visibility="Collapsed" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="LibraryRow" Style="{StaticResource NoteMenuRowStyle}" Click="OnLibraryRowClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE8F1;" FontSize="14" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="LibraryRowLabel" Grid.Column="1" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="HistoryRow" Style="{StaticResource NoteMenuRowStyle}" Click="OnHistoryRowClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Grid.Column="0" Glyph="&#xE81C;" FontSize="14" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="HistoryRowLabel" Grid.Column="1" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <Button x:Name="DeleteRow" Style="{StaticResource NoteMenuRowStyle}" Click="OnDeleteRowClicked">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon x:Name="DeleteRowIcon" Grid.Column="0" Glyph="&#xE74D;" FontSize="14" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="DeleteRowLabel" Grid.Column="1" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                </ScrollViewer>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <Button x:Name="CloseButton" Style="{StaticResource ChromeButtonStyle}" Click="OnCloseClicked">
                        <FontIcon Glyph="&#xE711;" FontSize="12" />
                    </Button>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Attached images, shown as images. They sit above the text rather than inline
                    with it because the body is a plain TextBox: it can hold the note's words or a
                    path to a picture, but it cannot draw one, and a line of percent-escaped path
                    is not what the user attached. The strip is capped in
                    OnSurfaceSizeChanged so a screenshot cannot push the writing off the note.
                -->
                <ScrollViewer
                    x:Name="ImageStripScroller"
                    Grid.Row="0"
                    Margin="0,0,0,6"
                    Visibility="Collapsed"
                    HorizontalScrollMode="Disabled"
                    HorizontalScrollBarVisibility="Disabled"
                    VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ImageStrip" Spacing="6" />
                </ScrollViewer>

                <TextBox
                    x:Name="ContentBox"
                    Grid.Row="1"
                    AcceptsReturn="True"
                    TextWrapping="Wrap"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    PreviewKeyDown="OnContentPreviewKeyDown"
                    Paste="OnPasteRequested"
                    GotFocus="OnEditorFocusChanged"
                    LostFocus="OnEditorFocusChanged"
                    SelectionChanged="OnSelectionChanged"
                    TextChanged="OnTextChanged">

                    <!--
                        Every command on the format bar is also an accelerator here. The bar is what
                        makes the commands discoverable; the accelerators are what make them fast, and
                        neither is the only way in.
                    -->
                    <TextBox.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="B" Invoked="OnBoldInvoked" />
                        <KeyboardAccelerator Modifiers="Control" Key="I" Invoked="OnItalicInvoked" />
                        <KeyboardAccelerator Modifiers="Control" Key="U" Invoked="OnUnderlineInvoked" />
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="X" Invoked="OnStrikethroughInvoked" />
                        <KeyboardAccelerator Modifiers="Control" Key="K" Invoked="OnLinkInvoked" />
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="K" Invoked="OnCodeInvoked" />
                        <KeyboardAccelerator Modifiers="Control" Key="Number1" Invoked="OnHeading1Invoked" />
                        <KeyboardAccelerator Modifiers="Control" Key="Number2" Invoked="OnHeading2Invoked" />
                        <KeyboardAccelerator Modifiers="Control" Key="Number3" Invoked="OnHeading3Invoked" />
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="L" Invoked="OnBulletInvoked" />
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="C" Invoked="OnChecklistInvoked" />
                        <KeyboardAccelerator Modifiers="Control" Key="Enter" Invoked="OnToggleCheckInvoked" />
                    </TextBox.KeyboardAccelerators>
                </TextBox>
            </Grid>

            <!--
                The format bar keeps its row even while invisible. Letting it collapse would reflow
                the note's text every time the pointer crosses the surface, which is a worse cost
                than a strip of empty paper at the bottom of a resting note.
            -->
            <StackPanel
                x:Name="FormatBar"
                Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Center"
                Height="28"
                Spacing="2"
                Opacity="0">
                <StackPanel.OpacityTransition>
                    <ScalarTransition Duration="0:0:0.12" />
                </StackPanel.OpacityTransition>

                <Button x:Name="BoldButton" Style="{StaticResource FormatButtonStyle}" Click="OnBoldClicked">
                    <TextBlock Text="B" FontWeight="Bold" FontSize="14" />
                </Button>
                <Button x:Name="ItalicButton" Style="{StaticResource FormatButtonStyle}" Click="OnItalicClicked">
                    <TextBlock Text="I" FontStyle="Italic" FontSize="14" />
                </Button>
                <Button x:Name="UnderlineButton" Style="{StaticResource FormatButtonStyle}" Click="OnUnderlineClicked">
                    <TextBlock Text="U" TextDecorations="Underline" FontSize="14" />
                </Button>
                <Button x:Name="StrikethroughButton" Style="{StaticResource FormatButtonStyle}" Click="OnStrikethroughClicked">
                    <TextBlock Text="ab" TextDecorations="Strikethrough" FontSize="14" />
                </Button>

                <Border x:Name="FormatSeparator" Width="1" Height="14" Margin="4,0" />

                <Button x:Name="BulletButton" Style="{StaticResource FormatButtonStyle}" Click="OnBulletClicked">
                    <FontIcon Glyph="&#xE8FD;" FontSize="14" />
                </Button>
                <Button x:Name="ChecklistButton" Style="{StaticResource FormatButtonStyle}" Click="OnChecklistClicked">
                    <FontIcon Glyph="&#xE73A;" FontSize="14" />
                </Button>
                <Button x:Name="ImageButton" Style="{StaticResource FormatButtonStyle}" Click="OnInsertImageClicked">
                    <FontIcon Glyph="&#xE91B;" FontSize="14" />
                </Button>

                <!--
                    Shown only while text is selected, and only when a model can run. Both act on
                    the selection alone — the AI menu already does that, but it costs three clicks
                    and a menu that covers the very text being worked on. Collapsed rather than
                    faded so they take no width at rest.
                -->
                <Border x:Name="SelectionSeparator" Width="1" Height="14" Margin="4,0" Visibility="Collapsed" />

                <Button x:Name="SelectionSummarize" Style="{StaticResource SelectionActionStyle}" Visibility="Collapsed" Click="OnSelectionSummarizeClicked">
                    <FontIcon Glyph="&#xE71C;" FontSize="13" />
                </Button>
                <Button x:Name="SelectionConcise" Style="{StaticResource SelectionActionStyle}" Visibility="Collapsed" Click="OnSelectionConciseClicked">
                    <FontIcon Glyph="&#xE8C6;" FontSize="13" />
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
