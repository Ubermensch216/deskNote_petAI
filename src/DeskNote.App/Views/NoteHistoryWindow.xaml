<Window
    x:Class="DeskNote.App.Views.NoteHistoryWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:DeskNote.App.Views">

    <!--
        Versions on the left, the chosen one on the right. Nothing here changes the note until the
        restore button is pressed, and that restore is itself an ordinary content write — it
        checkpoints the current text first, so restoring the wrong version is itself undoable.
    -->
    <Grid Padding="20,16,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="HistoryTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="HistoryHint"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView
                x:Name="RevisionList"
                Grid.Column="0"
                SelectionMode="Single"
                SelectionChanged="OnRevisionSelected">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:RevisionChoice">
                        <StackPanel Spacing="1" Padding="0,6">
                            <TextBlock Text="{x:Bind When}" />
                            <TextBlock
                                Text="{x:Bind Origin}"
                                Style="{ThemeResource CaptionTextBlockStyle}"
                                Opacity="0.65" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border
                Grid.Column="1"
                CornerRadius="8"
                Padding="12"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
                <ScrollViewer>
                    <TextBlock
                        x:Name="RevisionBody"
                        IsTextSelectionEnabled="True"
                        TextWrapping="Wrap"
                        FontFamily="Consolas, monospace" />
                </ScrollViewer>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="Status"
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.6"
                TextWrapping="Wrap" />

            <Button
                x:Name="RestoreButton"
                Grid.Column="1"
                Style="{ThemeResource AccentButtonStyle}"
                IsEnabled="False"
                Click="OnRestoreClicked" />

            <Button x:Name="CloseButton" Grid.Column="2" Click="OnCloseClicked" />
        </Grid>
    </Grid>
</Window>
