<Window
    x:Class="DeskNote.App.Views.NotesExplorerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:abstractions="using:DeskNote.Core.Abstractions"
    xmlns:views="using:DeskNote.App.Views">

    <Grid x:Name="Root" ColumnSpacing="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- The two ways of filtering: notebooks and tags. -->
        <Grid Grid.Column="0" Padding="12,16,8,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--
                New, rename and delete sit on the notebook list rather than in the bottom bar:
                they act on what is selected right underneath them, and a rename with no visible
                relationship to the list it changes is a command nobody finds.
            -->
            <Grid Grid.Row="0" ColumnSpacing="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="NotebooksHeader"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Style="{ThemeResource CaptionTextBlockStyle}" />

                <Button x:Name="NewNotebookButton" Grid.Column="1" Width="30" Height="28" Padding="0" Click="OnNewNotebookClicked">
                    <FontIcon Glyph="&#xE710;" FontSize="12" />
                </Button>
                <Button x:Name="RenameNotebookButton" Grid.Column="2" Width="30" Height="28" Padding="0" Click="OnRenameNotebookClicked">
                    <FontIcon Glyph="&#xE70F;" FontSize="12" />
                </Button>
                <Button x:Name="DeleteNotebookButton" Grid.Column="3" Width="30" Height="28" Padding="0" Click="OnDeleteNotebookClicked">
                    <FontIcon Glyph="&#xE74D;" FontSize="12" />
                </Button>
            </Grid>

            <ListView
                x:Name="NotebookList"
                Grid.Row="1"
                SelectionMode="Single"
                SelectionChanged="OnNotebookChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:NotebookChoice">
                        <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <TextBlock
                Grid.Row="2"
                Margin="4,8,0,0"
                Style="{ThemeResource CaptionTextBlockStyle}"
                x:Name="TagsHeader" />

            <ListView
                x:Name="TagList"
                Grid.Row="3"
                SelectionMode="Single"
                SelectionChanged="OnTagChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="views:TagChoice">
                        <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <Grid Grid.Column="1" Padding="12,16,16,12" RowSpacing="10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <AutoSuggestBox
                    x:Name="SearchBox"
                    QueryIcon="Find"
                    TextChanged="OnSearchTextChanged" />

                <!--
                    The list also reloads itself when a note is saved elsewhere. The button is for
                    the case that cannot be caught from in here — a change made while a selection
                    was being held, or simple doubt about whether what is on screen is current.
                -->
                <Button
                    x:Name="RefreshButton"
                    Grid.Column="1"
                    Width="36"
                    Padding="0"
                    Click="OnRefreshClicked">
                    <FontIcon Glyph="&#xE72C;" FontSize="14" />
                </Button>
            </Grid>

            <Grid Grid.Row="1" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="SelectionText"
                    VerticalAlignment="Center"
                    Opacity="0.72"
                    Style="{ThemeResource CaptionTextBlockStyle}" />
                <Button
                    x:Name="SelectAllButton"
                    Grid.Column="1"
                    Click="OnSelectAllClicked" />
                <Button
                    x:Name="ClearSelectionButton"
                    Grid.Column="2"
                    Click="OnClearSelectionClicked" />
                <!-- The notebooks are read when the flyout opens, so a notebook made a moment
                     ago in the sidebar is already a destination. -->
                <Button x:Name="MoveToNotebookButton" Grid.Column="3">
                    <Button.Flyout>
                        <MenuFlyout x:Name="MoveToNotebookFlyout" Opening="OnMoveFlyoutOpening" />
                    </Button.Flyout>
                </Button>
                <Button
                    x:Name="DeleteSelectedButton"
                    Grid.Column="4"
                    Click="OnDeleteSelectedClicked" />
            </Grid>

            <ListView
                x:Name="Results"
                Grid.Row="2"
                SelectionMode="Multiple"
                IsMultiSelectCheckBoxEnabled="True"
                IsItemClickEnabled="True"
                ItemClick="OnResultClicked"
                SelectionChanged="OnResultSelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="abstractions:NoteSummary">
                        <Grid Padding="4,8" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Colour chip, so a note is recognisable here the way it is on the desktop. -->
                            <Border
                                Grid.Column="0"
                                Width="10"
                                Height="34"
                                VerticalAlignment="Top"
                                CornerRadius="5"
                                Background="{x:Bind views:NoteRowFormat.ColorBrush(ColorKey)}" />

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock
                                    FontWeight="SemiBold"
                                    Text="{x:Bind views:NoteRowFormat.TitleOrFallback(Title, Preview)}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Opacity="0.75"
                                    MaxLines="2"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Preview}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    Opacity="0.6"
                                    Style="{ThemeResource CaptionTextBlockStyle}"
                                    Text="{x:Bind views:NoteRowFormat.Metadata(UpdatedAt, ChecklistDone, ChecklistTotal, Tags, NextReminderAt)}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Row="3" ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    x:Name="StatusText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Opacity="0.7"
                    Style="{ThemeResource CaptionTextBlockStyle}" />

            </Grid>
        </Grid>
    </Grid>
</Window>
