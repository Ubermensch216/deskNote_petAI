<Window
    x:Class="DeskNote.App.Views.ReminderWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        The phrase goes in, what was understood comes back, and only then is a reminder created.
        A misread date that fires on the wrong day is the failure this window exists to prevent —
        the user has to be able to see "화요일" turned into a Tuesday before agreeing to it.
    -->
    <Grid Padding="20,16,20,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock x:Name="ReminderTitle" Style="{ThemeResource SubtitleTextBlockStyle}" />
            <TextBlock
                x:Name="ReminderHint"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.7"
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBox
                x:Name="PhraseBox"
                Grid.Column="0"
                AcceptsReturn="False"
                KeyDown="OnPhraseKeyDown" />

            <Button
                x:Name="ReadButton"
                Grid.Column="1"
                Style="{ThemeResource AccentButtonStyle}"
                Click="OnReadClicked" />
        </Grid>

        <Border
            Grid.Row="2"
            CornerRadius="8"
            Padding="16"
            BorderThickness="1"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}">
            <Grid>
                <StackPanel
                    x:Name="RunningPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="10"
                    Visibility="Collapsed">
                    <ProgressRing x:Name="Progress" IsActive="False" Width="28" Height="28" />
                    <TextBlock x:Name="RunningLabel" HorizontalAlignment="Center" Opacity="0.8" />
                </StackPanel>

                <StackPanel
                    x:Name="ResultPanel"
                    VerticalAlignment="Center"
                    Spacing="6"
                    Visibility="Collapsed">
                    <TextBlock
                        x:Name="ResultWhen"
                        Style="{ThemeResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="ResultRepeat"
                        Opacity="0.75"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Shown only after a phrase failed to resolve, never as an opening state. -->
                <TextBlock
                    x:Name="EmptyLabel"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Opacity="0.5"
                    Visibility="Collapsed"
                    TextWrapping="Wrap"
                    TextAlignment="Center" />
            </Grid>
        </Border>

        <Grid Grid.Row="3" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock
                x:Name="Status"
                Grid.Column="0"
                VerticalAlignment="Center"
                Style="{ThemeResource CaptionTextBlockStyle}"
                Opacity="0.6"
                TextWrapping="Wrap" />

            <Button
                x:Name="CreateButton"
                Grid.Column="1"
                Style="{ThemeResource AccentButtonStyle}"
                IsEnabled="False"
                Click="OnCreateClicked" />

            <Button x:Name="CloseButton" Grid.Column="2" Click="OnCloseClicked" />
        </Grid>
    </Grid>
</Window>
