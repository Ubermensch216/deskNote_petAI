<Window
    x:Class="DeskNote.App.Views.PetGrowthGuideWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="18">

            <StackPanel Spacing="5">
                <TextBlock
                    x:Name="PageTitle"
                    Style="{ThemeResource TitleTextBlockStyle}" />
                <TextBlock
                    x:Name="Introduction"
                    Opacity="0.75"
                    TextWrapping="Wrap" />
            </StackPanel>

            <Border
                Padding="14"
                CornerRadius="12"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="AppBudgetLabel" Opacity="0.75" />
                        <TextBlock x:Name="AppBudgetValue" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock x:Name="CareBudgetLabel" Opacity="0.75" />
                        <TextBlock x:Name="CareBudgetValue" FontSize="18" FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="StagesHeader"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel x:Name="StageRows" Spacing="9" />
                </Border>
                <TextBlock x:Name="CareDayNote" Opacity="0.75" TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="AppHeader"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel x:Name="AppRows" Spacing="12" />
                </Border>
            </StackPanel>

            <StackPanel Spacing="8">
                <TextBlock
                    x:Name="CareHeader"
                    Style="{ThemeResource SubtitleTextBlockStyle}" />
                <Border
                    Padding="16"
                    CornerRadius="12"
                    Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1">
                    <StackPanel x:Name="CareRows" Spacing="12" />
                </Border>
            </StackPanel>

            <Border
                Padding="16"
                CornerRadius="12"
                Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                <StackPanel Spacing="7">
                    <TextBlock x:Name="TipsHeader" FontWeight="SemiBold" />
                    <StackPanel x:Name="TipRows" Spacing="7" />
                </StackPanel>
            </Border>

            <Button
                x:Name="CloseButton"
                HorizontalAlignment="Right"
                Click="OnCloseClicked" />
        </StackPanel>
    </ScrollViewer>
</Window>
