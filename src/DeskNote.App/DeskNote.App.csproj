<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>DeskNote.App</RootNamespace>
    <AssemblyName>DeskNote</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\DeskNote.ico</ApplicationIcon>
    <UseWinUI>true</UseWinUI>

    <!--
      Unpackaged + self-contained Windows App SDK: the app runs straight from `dotnet run`
      without a separately installed Windows App SDK runtime, which is what makes a
      Visual-Studio-free development loop possible. MSIX packaging is added for release (M6+).
    -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>

    <!--
      Keep the Windows App SDK native files beside the executable. With .NET 10, bundling these
      files into a single executable can fail before App is created (WindowsAppSDK issue #6058).
      The self-contained folder publish still requires no separately installed .NET/WASDK runtime.
    -->
    <PublishSingleFile>false</PublishSingleFile>

    <!--
      On by default in the WinUI templates, and `dotnet publish` needs it: without it the publish
      output silently loses DeskNote.pri, and every window then dies with a XamlParseException the
      moment it is constructed. It costs the build nothing here - the app is still unpackaged.
    -->
    <EnableMsixTooling>true</EnableMsixTooling>

    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DeskNote.Ai\DeskNote.Ai.csproj" />
    <ProjectReference Include="..\DeskNote.Core\DeskNote.Core.csproj" />
    <ProjectReference Include="..\DeskNote.Companion.Core\DeskNote.Companion.Core.csproj" />
    <ProjectReference Include="..\DeskNote.Data\DeskNote.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Companion\*-walk.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\Companion\*-rest.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
