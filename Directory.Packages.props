<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <ItemGroup Label="UI">
    <!--
      The Windows App SDK metapackage drags in AI, ML, Search and Widgets, which this app never touches:
      about fifty megabytes of ONNX Runtime, DirectML and projections in every download. Only the
      components a WinUI window actually needs are referenced, at the versions the metapackage
      2.4.0 resolved to.
    -->
    <PackageVersion Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.6" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.6" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.DWrite" Version="2.1.0" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Runtime" Version="2.4.0" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2526" />
  </ItemGroup>

  <!--
    Report p6 warns that a WAL-reset defect shipped through SQLite 3.51.2. The SQLite build is
    whatever SQLitePCLRaw bundles, so the version is pinned here and MigrationRunner additionally
    asserts sqlite_version() at startup rather than trusting the package graph.
  -->
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.11" />
    <PackageVersion Include="Dapper" Version="2.1.79" />
  </ItemGroup>

  <!--
    The pet's drawn characters are painted with GDI+, the way the project they were taken from
    paints them. WinUI has no retained-mode drawing of its own that offers path gradients and
    clipping at this level of control, so the frame is painted into a bitmap and handed over.
  -->
  <ItemGroup Label="Pet rendering">
    <PackageVersion Include="System.Drawing.Common" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Hosting">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11" />
  </ItemGroup>

  <ItemGroup Label="Testing">
    <PackageVersion Include="xunit.v3" Version="4.0.0" />
  </ItemGroup>

</Project>
