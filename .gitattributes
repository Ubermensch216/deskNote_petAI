* text=auto

# Keep source and documentation deterministic across Windows and CI checkouts.
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.slnx text eol=lf
*.xaml text eol=lf
*.xml text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.py text eol=lf

# Windows shells read these; a batch file with LF-only endings breaks label jumps,
# and PowerShell 5.1 needs the BOM that these files are stored with.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

*.ico binary
*.png binary
*.jpg binary
*.pdf binary
