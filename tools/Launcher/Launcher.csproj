<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The single file people are given.

    DeskNote itself cannot be one exe: a WinUI app needs its resource index, its images and a
    dozen native libraries beside it, and bundling them into a single-file publish fails at
    startup (docs/development.md says why). So the one exe is a small .NET Framework program that
    carries the real, published app inside itself as a zip and unpacks it on first run.

    .NET Framework is the point of it. 4.7.2 ships with Windows 10 from version 1803 on, and with
    11, so this program starts on a machine with nothing installed and on every Windows the app
    itself supports (1809 and later); a .NET 10 one would first ask for .NET 10, which is exactly
    the step this exists to remove. 4.7.2 rather than 4.8 because 1809 does not have 4.8.

    Not in DeskNote.slnx on purpose: it has nothing to build until a publish has made the zip it
    carries, so scripts/publish-win-x64.ps1 builds it, after that. Run directly with no
    PayloadZip it still builds, and says there is nothing in it when started.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>DeskNote</AssemblyName>
    <RootNamespace>DeskNote.Launcher</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RestorePackagesWithLockFile>false</RestorePackagesWithLockFile>
    <ApplicationIcon>..\..\src\DeskNote.App\Assets\DeskNote.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Prefer32Bit>false</Prefer32Bit>
    <PlatformTarget>x64</PlatformTarget>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version Condition="'$(Version)' == ''">1.0.0</Version>
    <Product>DeskNote</Product>
    <Company>DeskNote</Company>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <!-- What the exe carries: the published app as a zip, and a name for it. -->
  <ItemGroup Condition="'$(PayloadZip)' != ''">
    <EmbeddedResource Include="$(PayloadZip)" LogicalName="payload.zip" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>PayloadId</_Parameter1>
      <_Parameter2>$(PayloadId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
