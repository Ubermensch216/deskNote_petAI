<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not in DeskNote.slnx on purpose. This is documentation tooling: it seeds a throwaway database
    for the screen photographs in docs/images/, and it has no place in the product's build or CI.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeskNote.Tools.DemoSeeder</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeskNote.Core\DeskNote.Core.csproj" />
    <ProjectReference Include="..\..\src\DeskNote.Data\DeskNote.Data.csproj" />
    <ProjectReference Include="..\..\src\DeskNote.Companion.Core\DeskNote.Companion.Core.csproj" />
  </ItemGroup>

</Project>
