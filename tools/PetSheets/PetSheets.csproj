<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Not in DeskNote.slnx on purpose: this is art tooling. It draws the sprite sheets the five
    rig-drawn characters need wherever the app still shows a still picture of a pet (settings,
    dashboard, growth guide), and prints the bounds of the drawing for PetArtBounds. The pet on the
    desktop is drawn live and does not use them.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>DeskNote.Tools.PetSheets</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\DeskNote.Companion.Core\DeskNote.Companion.Core.csproj" />
    <ProjectReference Include="..\..\src\DeskNote.Companion.Rig\DeskNote.Companion.Rig.csproj" />
    <PackageReference Include="System.Drawing.Common" />
  </ItemGroup>

</Project>
